#!/bin/sh
# ORCHE command-line launcher: run bin/orche.py under the first Python 3.11+ available.
#
# A login shell's bare `python3` can be macOS's /usr/bin/python3 (3.9); the search in
# lib/find_python.sh (shared with hooks/run.sh) skips it. With no suitable interpreter the CLI is
# loud: the guard message goes to stderr and the exit code is 1 (hooks, by contrast, fail open).

self=$0
while [ -L "$self" ]; do   # a symlink to this launcher (e.g. in ~/.local/bin) still finds the plugin
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=${self%/*}/$link ;;
  esac
done
case $self in
  */*) dir=${self%/*} ;;
  *) dir=. ;;
esac

if [ -r "$dir/../lib/find_python.sh" ] && . "$dir/../lib/find_python.sh" && orche_find_python; then
  exec "$ORCHE_PY" "$dir/orche.py" "$@"
fi
echo "orche: ORCHE needs Python 3.11+ (none found; tried $ORCHE_PY_CANDIDATES); brew install python" >&2
exit 1
