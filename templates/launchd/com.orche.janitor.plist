<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.orche.janitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ORCHE_BIN}}</string>
    <string>janitor</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ORCHE_HOME</key>
    <string>{{ORCHE_HOME}}</string>
    <key>PATH</key>
    <string>{{PATH}}</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>{{ORCHE_HOME}}/logs/janitor.log</string>
  <key>StandardErrorPath</key>
  <string>{{ORCHE_HOME}}/logs/janitor.log</string>
</dict>
</plist>
