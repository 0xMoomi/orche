          "flow.fanout": 20,
          "flow.depth": 3,
          "flow.briefs_per_hour": 60,
          "flow.revisions": 3,
          "flow.runs_per_unit": 4,
          "flow.max_unit_cost_usd": 10,
          "flow.max_project_cost_usd": 150
