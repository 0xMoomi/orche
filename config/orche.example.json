          "feature_min_free_disk_mb": 2048,
          "flow.fanout": 5,
          "flow.depth": 3,
          "flow.briefs_per_hour": 20,
          "flow.revisions": 3,
          "flow.runs_per_unit": 4,
          "flow.max_unit_cost_usd": 10,
          "flow.max_project_cost_usd": 30
        },
        "limits": {
          "per_project_per_day": 3,
          "per_project_per_week": 10,
