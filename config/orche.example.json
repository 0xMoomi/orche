          "runner.max_parallel": 20,
          "runner.max_parallel_total": 24,
          "runner.min_free_mb": 3072,
          "runner.queue_wait_s": 7200,
          "feature_panes": false,
          "feature_min_free_disk_mb": 10240,
          "flow.fanout": 30,
          "flow.depth": 3,
          "flow.briefs_per_hour": 90,
          "flow.revisions": 3,
          "flow.runs_per_unit": 4,
          "flow.max_unit_cost_usd": 10,
          "flow.max_project_cost_usd": 250
        },
        "limits": {
          "per_project_per_day": 30,
          "per_project_per_week": 90,
          "per_request_auto": 30,
          "global_per_day_freeze": 60,
          "max_awake_sessions": 12
        }
      }
    }
