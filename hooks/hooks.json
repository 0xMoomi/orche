{
  "hooks": {
    "Stop": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" dispatch_relay"}]}
    ],
    "StopFailure": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" dispatch_relay"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" report_inject"}]}
    ],
    "PreToolUse": [
      {"matcher": "Read|Bash|Grep|Edit|Write|Monitor|Agent|Task",
       "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" env_read_gate"}]},
      {"matcher": "Edit|Write|NotebookEdit|MultiEdit",
       "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" scope_gate"}]}
    ],
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session_start"}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session_end"}]}
    ]
  }
}
